# 이 파일을 .env로 복사하고 값을 채웁니다. (.env는 git에 올라가지 않습니다)
# 키 발급·확인 방법: docs/SETUP_GUIDE.md
# 키가 없는 자료는 수집하지 않고 이유를 표시합니다. 가상 자료(SAMPLE)는 ADETECT_SAMPLE_MODE=true일 때만 씁니다.

# 검색 관심도 추이·관련 뉴스 — NAVER API HUB (무료)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 월간 검색량 — 네이버 검색광고 API, 위와 별도 계정 (무료)
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# Meta 광고 소재·Instagram — Apify (유료)
APIFY_API_TOKEN=
# APIFY_META_ADS_ACTOR=curious_coder/facebook-ads-library-scraper

# 검색 화면 광고 영역 AI 보완 판독 — Google Gemini (유료)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# YouTube 공식 채널 — YouTube Data API v3 (무료, 할당량 제한)
YOUTUBE_API_KEY=

# 실행 모드 — true면 외부 요청 없이 가상 자료 (화면에 SAMPLE 표시)
ADETECT_SAMPLE_MODE=false

# 저장 위치·한도 (비워두면 기본값)
# ADETECT_DB_PATH=storage/adetect.db
# ADETECT_EXPORT_DIR=storage/exports
# ADETECT_EXPORT_MAX_RUNS=20
# ADETECT_EXPORT_MAX_BYTES=5368709120
# ADETECT_EVIDENCE_DIR=storage/evidence
# ADETECT_EVIDENCE_MAX_BYTES=5368709120
# ADETECT_BACKUP_DIR=storage/backups
# 저장 공간 사용률 기준(파일/DB). 80%·90%에서 경고합니다.
# ADETECT_STORAGE_MAX_BYTES=5368709120
# ADETECT_DB_MAX_BYTES=524288000

# 원격 DB·Storage (검증 전 준비 코드 — 로컬 사용에서는 설정하지 않음)
# ADETECT_DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# ADETECT_STORAGE_BUCKET=
