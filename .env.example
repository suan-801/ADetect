# 이 파일을 복사해 .env로 만들고 실제 값을 채워 넣으세요. (.env는 git에 올라가지 않습니다)
# 키가 비어 있으면 앱은 자동으로 목업(mock) 데이터로 동작합니다 (config/settings.py의 USE_MOCK_DATA 참고).

# 네이버 오픈API (DataLab / 검색 / 뉴스) - developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 네이버 검색광고(키워드도구) - DataLab과 별도 계정/인증 (PRD §21-10)
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# Apify (Meta Ads Library / Instagram 프로필 스크래퍼)
APIFY_API_TOKEN=

# Google Gemini (멀티모달 분석)
GEMINI_API_KEY=
