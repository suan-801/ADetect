# 이 파일을 복사해 .env로 만들고 실제 값을 채워 넣으세요. (.env는 git에 올라가지 않습니다)
# 새 자료 수집 화면은 키가 없으면 미수집으로 표시합니다. SAMPLE은 명시적으로 켜야 합니다.

# NAVER API HUB (DataLab / 검색 / 뉴스)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 네이버 검색광고(키워드도구) - DataLab과 별도 계정/인증 (PRD §21-10)
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# Apify (Meta Ads Library / Instagram 프로필 스크래퍼)
APIFY_API_TOKEN=

# Google Gemini (멀티모달 분석)
GEMINI_API_KEY=

# ── 아래는 선택 항목 — 비워두면 config/settings.py의 기본값을 그대로 사용합니다 ──────
# GEMINI_MODEL=gemini-flash-latest
# APIFY_META_ADS_ACTOR=curious_coder/facebook-ads-library-scraper
# ADETECT_DB_PATH=storage/adetect.db

# MVP 실행/저장 설정
YOUTUBE_API_KEY=
ADETECT_SAMPLE_MODE=false
ADETECT_EXPORT_MAX_RUNS=20
ADETECT_EXPORT_MAX_BYTES=5368709120
ADETECT_EVIDENCE_DIR=storage/evidence
ADETECT_EVIDENCE_MAX_BYTES=5368709120
# ADETECT_EXPORT_DIR=storage/exports
# ADETECT_BACKUP_DIR=storage/backups
# 저장 공간 전체 한도(파일/DB). 사용률 80%·90%에서 경고합니다.
# ADETECT_STORAGE_MAX_BYTES=5368709120
# ADETECT_DB_MAX_BYTES=524288000
